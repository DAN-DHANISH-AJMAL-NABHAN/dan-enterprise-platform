{
  "_note": "Enterprise admin portal Appwrite schema. Apply with Appwrite Console/CLI or convert to deployment scripts. All CMS collections include soft-delete fields used by the admin CRUD engine.",
  "databaseId": "enterprise_platform",
  "storageBuckets": [
    {
      "id": "media",
      "name": "Media Library",
      "fileSecurity": true,
      "maximumFileSize": 52428800,
      "allowedFileExtensions": ["jpg", "jpeg", "png", "webp", "gif", "svg", "mp4", "webm", "pdf", "doc", "docx", "xls", "xlsx", "csv", "zip"],
      "permissions": ["read(\"any\")", "create(\"users\")", "update(\"users\")", "delete(\"users\")"]
    }
  ],
  "commonAttributes": [
    { "key": "slug", "type": "string", "size": 160, "required": false },
    { "key": "status", "type": "string", "size": 32, "required": false, "default": "draft" },
    { "key": "sortOrder", "type": "integer", "required": false, "default": 0 },
    { "key": "featured", "type": "boolean", "required": false, "default": false },
    { "key": "seoTitle", "type": "string", "size": 255, "required": false },
    { "key": "seoDescription", "type": "string", "size": 1000, "required": false },
    { "key": "seoKeywords", "type": "string", "size": 128, "array": true, "required": false },
    { "key": "isDeleted", "type": "boolean", "required": false, "default": false },
    { "key": "deletedAt", "type": "datetime", "required": false }
  ],
  "collections": [
